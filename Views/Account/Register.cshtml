@model RegisterViewModel
@{
    ViewData["Title"] = "Tạo tài khoản";
    var returnUrl = ViewData["ReturnUrl"] as string;
}
<section class="portal-page">
    <div class="portal-card account-card">
        <aside class="account-story" aria-label="W Studio">
            <span class="account-story-kicker">W STUDIO · THỜI TRANG TUYỂN CHỌN</span>
            <h2>Phong cách<br />bắt đầu từ <em>bạn.</em></h2>
            <p>Tạo tài khoản để lưu những lựa chọn yêu thích và theo dõi hành trình đơn hàng tại W Studio.</p>
            <span class="account-story-note">MỘT GỢI Ý ĐÚNG LÚC</span>
        </aside>
        <div class="account-form-panel">
            <a class="portal-brand" asp-controller="Home" asp-action="Index">W <span>STUDIO</span></a>
            <span class="portal-kicker">THÀNH VIÊN STUDIO</span>
            <h1>Tạo tài khoản</h1>
            <p>Tài khoản đăng ký mới được cấp quyền khách hàng.</p>
            <form asp-action="Register" method="post">
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                <label asp-for="DisplayName"></label>
                <input asp-for="DisplayName" class="portal-input" autocomplete="name" />
                <span asp-validation-for="DisplayName" class="field-error"></span>
                <label asp-for="Email"></label>
                <input asp-for="Email" class="portal-input" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
                <label asp-for="PhoneNumber"></label>
                <input asp-for="PhoneNumber" class="portal-input" autocomplete="tel" />
                <span asp-validation-for="PhoneNumber" class="field-error"></span>
                <label asp-for="Password"></label>
                <input asp-for="Password" class="portal-input" autocomplete="new-password" />
                <span asp-validation-for="Password" class="field-error"></span>
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="portal-input" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                <button class="portal-submit" type="submit">TẠO TÀI KHOẢN <span>→</span></button>
            </form>
            <div class="account-switch">Đã là thành viên? <a asp-action="Login" asp-route-returnUrl="@returnUrl">Đăng nhập</a></div>
            <a class="portal-back" asp-controller="Home" asp-action="Index">← Quay lại cửa hàng</a>
        </div>
            </div>
        </section>
        @section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
