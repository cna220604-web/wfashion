@{
    ViewData["Title"] = "Kiểm tra email";
}
<section class="portal-page">
    <div class="portal-card recovery-card recovery-message-card">
        <span class="recovery-mark" aria-hidden="true">✉</span>
        <span class="portal-kicker">HƯỚNG DẪN ĐANG TRÊN ĐƯỜNG ĐẾN</span>
        <h1>Kiểm tra hộp thư</h1>
        <p>Nếu email bạn nhập thuộc một tài khoản W Studio, hướng dẫn đặt lại mật khẩu sẽ được gửi đến địa chỉ đó. Hãy kiểm tra cả thư mục spam.</p>
        <a class="portal-submit portal-link-button" asp-action="Login">QUAY LẠI ĐĂNG NHẬP <span>→</span></a>
    </div>
</section>
