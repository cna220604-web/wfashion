@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}
<section class="portal-page">
    <div class="portal-card recovery-card">
        <a class="portal-brand" asp-controller="Home" asp-action="Index">W <span>STUDIO</span></a>
        <span class="portal-kicker">KHÔNG SAO CẢ</span>
        <h1>Quên mật khẩu?</h1>
        <p>Nhập email đăng ký. Nếu tài khoản tồn tại, chúng tôi sẽ gửi liên kết để bạn tạo mật khẩu mới.</p>
        <form asp-action="ForgotPassword" method="post" class="recovery-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <label asp-for="Email"></label>
            <input asp-for="Email" class="portal-input" autocomplete="email" autofocus />
            <span asp-validation-for="Email" class="field-error"></span>
            <button class="portal-submit" type="submit">GỬI LIÊN KẾT ĐẶT LẠI <span>→</span></button>
        </form>
        <a class="portal-back" asp-action="Login">← Quay lại đăng nhập</a>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
