@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Tạo mật khẩu mới";
}
<section class="portal-page">
    <div class="portal-card recovery-card">
        <a class="portal-brand" asp-controller="Home" asp-action="Index">W <span>STUDIO</span></a>
        <span class="portal-kicker">BƯỚC CUỐI CÙNG</span>
        <h1>Tạo mật khẩu mới</h1>
        <p>Bạn có thể đặt mật khẩu tùy ý.</p>
        <form asp-action="ResetPassword" method="post" class="recovery-form">
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <label asp-for="Password"></label>
            <input asp-for="Password" class="portal-input" autocomplete="new-password" />
            <span asp-validation-for="Password" class="field-error"></span>
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" class="portal-input" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            <button class="portal-submit" type="submit">LƯU MẬT KHẨU MỚI <span>→</span></button>
        </form>
        <a class="portal-back" asp-action="Login">← Quay lại đăng nhập</a>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
