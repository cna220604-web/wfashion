@{
    ViewData["Title"] = "Đã đổi mật khẩu";
}
<section class="portal-page">
    <div class="portal-card recovery-card recovery-message-card">
        <span class="recovery-mark" aria-hidden="true">✓</span>
        <span class="portal-kicker">CẬP NHẬT THÀNH CÔNG</span>
        <h1>Mật khẩu đã được đổi</h1>
        <p>Bạn có thể đăng nhập bằng mật khẩu mới của mình.</p>
        <a class="portal-submit portal-link-button" asp-action="Login">ĐĂNG NHẬP <span>→</span></a>
    </div>
</section>
