@model AdminDashboardViewModel
@inject WebApplication1.Services.AvatarObjectStorage AvatarStorage
@{
    ViewData["Title"] = "Quản trị hệ thống";
    var requestedTab = Context.Request.Query["tab"].ToString();
    var tab = requestedTab is "products" or "videos" or "expenses" or "partners" or "users" or "orders" or "promotions" ? requestedTab : "overview";
    var selectedUserGroup = Context.Request.Query["userGroup"].ToString() is "admin" or "employee" or "customer" ? Context.Request.Query["userGroup"].ToString() : "admin";
    var stockReceiptSaved = ViewData["StockReceiptSaved"] is true;
}
<section class="dashboard-page admin-dashboard">
    <div class="dashboard-heading"><div><span class="portal-kicker">ADMIN WORKSPACE · 01</span><h1>Quản trị cửa hàng</h1><p>Chọn một khu vực để quản lý mà không phải cuộn qua các mục khác.</p></div><span class="role-badge admin-badge">QUẢN TRỊ VIÊN</span></div>
    @if (TempData["Notice"] is string notice) { <div class="portal-alert success">@notice</div> }
    @if (TempData["Error"] is string error) { <div class="portal-alert danger">@error</div> }
    <nav class="dashboard-tabs" aria-label="Khu vực quản trị"><a class="@(tab == "overview" ? "is-active" : "")" href="?tab=overview">Tổng quan</a><a class="@(tab == "products" ? "is-active" : "")" href="?tab=products">Sản phẩm & tồn kho</a><a class="@(tab == "videos" ? "is-active" : "")" href="?tab=videos">Video fashion</a><a class="@(tab == "expenses" ? "is-active" : "")" href="?tab=expenses">Nhập hàng & chi phí</a><a class="@(tab == "partners" ? "is-active" : "")" href="?tab=partners">Đối tác</a><a class="@(tab == "users" ? "is-active" : "")" href="?tab=users">Tài khoản & vai trò</a><a class="@(tab == "orders" ? "is-active" : "")" href="?tab=orders">Đơn hàng</a><a class="@(tab == "promotions" ? "is-active" : "")" href="?tab=promotions">Voucher</a></nav>

    @if (tab == "overview")
    {
        <div class="metric-grid">
            <article class="metric-card"><span>KHÁCH HÀNG</span><strong>@Model.CustomerCount</strong></article>
            <article class="metric-card"><span>NHÂN VIÊN</span><strong>@Model.EmployeeCount</strong></article>
            <article class="metric-card"><span>SẢN PHẨM ĐANG BÁN</span><strong>@Model.ProductCount</strong></article>
            <article class="metric-card"><span>ĐƠN CHỜ XÁC NHẬN</span><strong>@Model.PendingOrderCount</strong></article>
            <article class="metric-card sales-metric"><span>DOANH SỐ ĐƠN KHÔNG BỊ HỦY</span><strong>@Model.SalesTotal.ToString("N0")₫</strong></article>
            <article class="metric-card sales-metric"><span>TIỀN NHẬP HÀNG ĐÃ GHI</span><strong>@Model.StockPurchaseTotal.ToString("N0")₫</strong></article>
            <article class="metric-card sales-metric"><span>CHI PHÍ VẬN HÀNH</span><strong>@Model.OperatingExpenseTotal.ToString("N0")₫</strong></article>
            <article class="metric-card sales-metric"><span>ĐƠN HÀNG TRỪ CHI PHÍ ĐÃ GHI</span><strong>@Model.RecordedCashFlow.ToString("N0")₫</strong></article>
        </div>
        <p class="panel-help">Số chênh lệch tham khảo: doanh số đơn không bị hủy trừ tiền nhập hàng và chi phí vận hành đã ghi nhận; chưa phải số dư tiền thực tế.</p>
        <section class="portal-panel low-stock-panel">
            <div class="panel-heading"><div><span class="portal-kicker">CẢNH BÁO KHO · TỒN ≤ @Product.LowStockThreshold</span><h2>Sắp hết hàng</h2></div><a class="portal-outline-link" href="?tab=products">Quản lý tồn kho ↗</a></div>
            @if (Model.LowStockProducts.Count == 0)
            {
                <p class="empty-orders">Chưa có sản phẩm nào dưới ngưỡng cảnh báo.</p>
            }
            else
            {
                <ul class="low-stock-list">
                    @foreach (var product in Model.LowStockProducts)
                    {
                        <li><span><strong>@product.Name</strong><small>@product.Slug</small></span><b>@product.Stock còn</b></li>
                    }
                </ul>
            }
        </section>
    }
    else if (tab == "expenses")
    {
        <div class="admin-finance-forms">
            <section class="portal-panel management-panel"><div class="panel-heading"><div><span class="portal-kicker">KHO · NHẬN HÀNG</span><h2>Nhập hàng</h2></div><span class="panel-count">Tối đa 200 dòng / phiếu</span></div>
                <p class="panel-help">Chọn nhà cung cấp, rồi dán các cột từ Excel/Google Sheets hoặc thêm dòng. Có thể dùng mã hàng hoặc dán nhiều dòng trùng mã; tồn kho và lịch sử được cập nhật trong cùng một lần lưu.</p>
                <form asp-action="RecordStockReceipt" method="post" class="product-admin-form finance-form stock-receipt-form" data-stock-receipt-form data-stock-receipt-saved="@(stockReceiptSaved ? "true" : "false")">
                    <label>Nhà cung cấp<select name="PartnerId" class="portal-select" required><option value="">Chọn đối tác</option>@foreach (var partner in Model.BusinessPartners.Where(partner => partner.IsActive)) { <option value="@partner.Id">@partner.Code · @partner.Name</option> }</select></label>
                    <label>Ngày nhập<input name="ReceivedOn" class="portal-input" type="date" value="@DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7)).ToString("yyyy-MM-dd")" required /></label>
                    <label>Mã phiếu tự động<input class="portal-input" value="PN-@Model.NextStockReceiptNumber.ToString("D6")" readonly aria-label="Mã phiếu nhập dự kiến" /><small>Mã chính thức được cấp khi lưu phiếu.</small></label>
                    <label class="wide-field">Dán danh sách từ bảng tính<textarea class="portal-input stock-bulk-input" rows="4" data-stock-bulk-input placeholder="Mã sản phẩm&#9;Số lượng&#9;Giá nhập&#10;SKU-101&#9;12&#9;250000&#10;SKU-102&#9;5&#9;250.000"></textarea><small>Dán 3 cột mã sản phẩm, số lượng, giá nhập (Excel/Sheets hoặc dấu chấm phẩy). Giá chấp nhận dạng 250000, 250.000, 250,000 hoặc 250.000,50.</small></label>
                    <div class="stock-bulk-actions"><button class="mini-submit" type="button" data-stock-bulk-load>NẠP DÒNG VÀO PHIẾU</button><button class="text-action" type="button" data-stock-clear-all>Xóa toàn bộ dòng</button></div>
                    <p class="stock-bulk-feedback" data-stock-bulk-error aria-live="polite"></p>
                    <div class="stock-receipt-lines" data-stock-lines>
                        <div class="stock-receipt-line" data-stock-row>
                            <label for="stock-product-0">Sản phẩm<select id="stock-product-0" name="Items[0].ProductSlug" class="portal-select" data-stock-product required><option value="">Chọn sản phẩm</option>@foreach (var product in Model.Products) { <option value="@product.Slug">@product.Slug · @product.Name · tồn @product.Stock</option> }</select></label>
                            <label for="stock-quantity-0">Số lượng<input id="stock-quantity-0" name="Items[0].Quantity" class="portal-input" type="number" min="1" max="100000" data-stock-quantity required /></label>
                            <label for="stock-cost-0">Giá nhập / sản phẩm (₫)<input id="stock-cost-0" name="Items[0].UnitCost" class="portal-input" type="number" min="1" max="9999999999.99" step="0.01" data-stock-unit-cost required /></label>
                            <div class="stock-line-total">Thành tiền <output data-stock-line-total>0 ₫</output></div>
                            <button class="text-action danger-action" type="button" data-stock-remove-row aria-label="Xóa sản phẩm khỏi phiếu">Xóa dòng</button>
                        </div>
                    </div>
                    <template data-stock-row-template>
                        <div class="stock-receipt-line" data-stock-row>
                            <label for="stock-product-__index__">Sản phẩm<select id="stock-product-__index__" name="Items[__index__].ProductSlug" class="portal-select" data-stock-product required><option value="">Chọn sản phẩm</option>@foreach (var product in Model.Products) { <option value="@product.Slug">@product.Slug · @product.Name · tồn @product.Stock</option> }</select></label>
                            <label for="stock-quantity-__index__">Số lượng<input id="stock-quantity-__index__" name="Items[__index__].Quantity" class="portal-input" type="number" min="1" max="100000" data-stock-quantity required /></label>
                            <label for="stock-cost-__index__">Giá nhập / sản phẩm (₫)<input id="stock-cost-__index__" name="Items[__index__].UnitCost" class="portal-input" type="number" min="1" max="9999999999.99" step="0.01" data-stock-unit-cost required /></label>
                            <div class="stock-line-total">Thành tiền <output data-stock-line-total>0 ₫</output></div>
                            <button class="text-action danger-action" type="button" data-stock-remove-row aria-label="Xóa sản phẩm khỏi phiếu">Xóa dòng</button>
                        </div>
                    </template>
                    <select class="stock-product-template" data-stock-product-template aria-hidden="true" tabindex="-1"><option value=""></option>@foreach (var product in Model.Products) { <option value="@product.Slug">@product.Name</option> }</select>
                    <button class="mini-submit" type="button" data-stock-add-row>THÊM DÒNG SẢN PHẨM</button>
                    <div class="stock-receipt-summary">Tổng giá trị phiếu: <strong data-stock-total>0 ₫</strong></div>
                    <label class="wide-field">Ghi chú phiếu (không bắt buộc)<input name="Notes" class="portal-input" maxlength="500" /></label>
                    <button class="mini-submit" type="submit">LƯU PHIẾU & CỘNG TỒN KHO</button>
                </form>
            </section>
            <section class="portal-panel management-panel"><div class="panel-heading"><div><span class="portal-kicker">TÀI CHÍNH · CHI PHÍ</span><h2>Ghi nhận chi phí vận hành</h2></div></div>
                <p class="panel-help">Ghi các khoản như mặt bằng, điện nước, lương, marketing, đóng gói hoặc chi phí khác của shop.</p>
                <form asp-action="RecordOperatingExpense" method="post" class="product-admin-form finance-form">
                    <label>Nhóm chi phí<select name="Category" class="portal-select" required><option value="">Chọn nhóm chi phí</option><option>Thuê mặt bằng</option><option>Điện, nước, internet</option><option>Lương nhân viên</option><option>Marketing</option><option>Đóng gói & vận chuyển</option><option>Phần mềm & công cụ</option><option>Thuế & phí</option><option>Sửa chữa</option><option>Khác</option></select></label>
                    <label>Số tiền (₫)<input name="Amount" class="portal-input" type="number" min="1" max="9999999999.99" step="0.01" required /></label>
                    <label>Ngày chi<input name="SpentOn" class="portal-input" type="date" value="@DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7)).ToString("yyyy-MM-dd")" required /></label>
                    <label>Đơn vị nhận tiền<input name="Supplier" class="portal-input" maxlength="120" /></label>
                    <label class="wide-field">Nội dung chi<input name="Description" class="portal-input" maxlength="160" required /></label>
                    <label class="wide-field">Ghi chú<input name="Notes" class="portal-input" maxlength="500" /></label>
                    <button class="mini-submit" type="submit">LƯU CHI PHÍ</button>
                </form>
            </section>
        </div>
        <section class="portal-panel management-panel"><div class="panel-heading"><div><span class="portal-kicker">SỔ KHO · 50 GẦN NHẤT</span><h2>Lịch sử nhập hàng</h2></div></div>
            @if (Model.RecentStockReceipts.Count == 0) { <p class="empty-orders">Chưa có lần nhập hàng nào được ghi nhận.</p> }
            else { <div class="table-scroll"><table class="management-table"><thead><tr><th>Ngày nhập</th><th>Sản phẩm</th><th>Số lượng</th><th>Giá nhập</th><th>Thành tiền</th><th>Nhà cung cấp / mã phiếu</th></tr></thead><tbody>
            @foreach (var receipt in Model.RecentStockReceipts) { <tr><td>@receipt.ReceivedOn.ToString("dd/MM/yyyy")</td><td>@receipt.ProductName<small>@receipt.ProductSlug</small></td><td>@receipt.Quantity.ToString("N0")</td><td>@receipt.UnitCost.ToString("N0")₫</td><td>@receipt.TotalCost.ToString("N0")₫</td><td>@receipt.Supplier<small>@receipt.Reference</small></td></tr> }
            </tbody></table></div> }
        </section>
        <section class="portal-panel management-panel"><div class="panel-heading"><div><span class="portal-kicker">SỔ CHI · 50 GẦN NHẤT</span><h2>Lịch sử chi phí vận hành</h2></div></div>
            @if (Model.RecentOperatingExpenses.Count == 0) { <p class="empty-orders">Chưa có khoản chi nào được ghi nhận.</p> }
            else { <div class="table-scroll"><table class="management-table"><thead><tr><th>Ngày chi</th><th>Nhóm</th><th>Nội dung</th><th>Đơn vị nhận tiền</th><th>Số tiền</th></tr></thead><tbody>
            @foreach (var expense in Model.RecentOperatingExpenses) { <tr><td>@expense.SpentOn.ToString("dd/MM/yyyy")</td><td>@expense.Category</td><td>@expense.Description<small>@expense.Notes</small></td><td>@expense.Supplier</td><td>@expense.Amount.ToString("N0")₫</td></tr> }
            </tbody></table></div> }
        </section>
    }
    else if (tab == "partners")
    {
        <section class="portal-panel management-panel"><div class="panel-heading"><div><span class="portal-kicker">ĐỐI TÁC · NHÀ CUNG CẤP</span><h2>Thêm đối tác</h2></div><span class="panel-count">@Model.BusinessPartners.Count đối tác</span></div>
            <p class="panel-help">Đối tác đang hoạt động sẽ xuất hiện trong lựa chọn nhà cung cấp khi nhập kho. Ngừng sử dụng chỉ ẩn đối tác khỏi lựa chọn mới; lịch sử nhập hàng vẫn được giữ nguyên.</p>
            <form asp-action="CreateBusinessPartner" method="post" class="product-admin-form">
                <label>Mã đối tác<input name="Code" class="portal-input" minlength="2" maxlength="30" pattern="[A-Za-z0-9-]{2,30}" placeholder="NCC-001" required /></label>
                <label>Tên đối tác<input name="Name" class="portal-input" minlength="2" maxlength="120" required /></label>
                <label>Địa chỉ<input name="Address" class="portal-input" minlength="5" maxlength="240" autocomplete="street-address" required /></label>
                <label>Số điện thoại<input name="Phone" class="portal-input" type="tel" maxlength="30" autocomplete="tel" required /></label>
                <label>Email (không bắt buộc)<input name="Email" class="portal-input" type="email" maxlength="256" autocomplete="email" /></label>
                <label>Người liên hệ<input name="ContactName" class="portal-input" maxlength="100" /></label>
                <button class="mini-submit" type="submit">THÊM ĐỐI TÁC</button>
            </form>
        </section>
        <section class="portal-panel management-panel"><div class="panel-heading"><div><span class="portal-kicker">DANH BẠ ĐỐI TÁC</span><h2>Đối tác đã lưu</h2></div></div>
            @if (Model.BusinessPartners.Count == 0) { <p class="empty-orders">Chưa có đối tác nào. Thêm đối tác để sử dụng làm nhà cung cấp.</p> }
            else { <div class="table-scroll"><table class="management-table"><thead><tr><th>Mã / tên đối tác</th><th>Địa chỉ</th><th>Người liên hệ</th><th>Điện thoại</th><th>Email</th><th>Trạng thái / thao tác</th></tr></thead><tbody>
            @foreach (var partner in Model.BusinessPartners) { <tr><td><strong>@partner.Code</strong><small>@partner.Name</small></td><td>@partner.Address</td><td>@partner.ContactName</td><td>@partner.Phone</td><td>@partner.Email</td><td><details><summary>Chỉnh sửa</summary><form asp-action="UpdateBusinessPartner" method="post" class="product-admin-form"><input type="hidden" name="Id" value="@partner.Id" /><label>Mã<input name="Code" class="portal-input" value="@partner.Code" minlength="2" maxlength="30" pattern="[A-Za-z0-9-]{2,30}" required /></label><label>Tên<input name="Name" class="portal-input" value="@partner.Name" minlength="2" maxlength="120" required /></label><label>Địa chỉ<input name="Address" class="portal-input" value="@partner.Address" minlength="5" maxlength="240" required /></label><label>Điện thoại<input name="Phone" class="portal-input" value="@partner.Phone" type="tel" maxlength="30" required /></label><label>Email<input name="Email" class="portal-input" value="@partner.Email" type="email" maxlength="256" /></label><label>Người liên hệ<input name="ContactName" class="portal-input" value="@partner.ContactName" maxlength="100" /></label><button class="mini-submit" type="submit">LƯU THAY ĐỔI</button></form></details><form asp-action="SetBusinessPartnerStatus" method="post" class="inline-action-form"><input type="hidden" name="id" value="@partner.Id" /><input type="hidden" name="isActive" value="@(!partner.IsActive)" /><button class="text-action" type="submit">@(partner.IsActive ? "Ngừng dùng" : "Bật lại")</button></form><small>@(partner.IsActive ? "Đang hoạt động" : "Ngừng sử dụng")</small></td></tr> }
            </tbody></table></div> }
        </section>
    }
    else if (tab == "users")
    {
        <section class="portal-panel management-panel"><div class="panel-heading"><div><span class="portal-kicker">NHÂN SỰ · TẠO TÀI KHOẢN</span><h2>Tạo tài khoản nhân viên</h2></div><span class="panel-count">Cấp quyền vận hành</span></div>
            <p class="panel-help">Tài khoản mới được gán quyền Nhân viên và có thể đăng nhập ngay tại trang Đăng nhập. Có thể đặt mật khẩu tùy ý.</p>
            <form asp-action="CreateEmployee" method="post" class="product-admin-form">
                <label>Họ và tên<input name="DisplayName" class="portal-input" minlength="2" maxlength="100" autocomplete="name" required /></label>
                <label>Email đăng nhập<input name="Email" class="portal-input" type="email" maxlength="256" autocomplete="username" required /></label>
                <label>Số điện thoại<input name="PhoneNumber" class="portal-input" type="tel" maxlength="20" autocomplete="tel" /></label>
                <label>Mật khẩu tạm thời<input name="Password" class="portal-input" type="password" maxlength="100" autocomplete="new-password" required /></label>
                <label>Xác nhận mật khẩu<input name="ConfirmPassword" class="portal-input" type="password" maxlength="100" autocomplete="new-password" required /></label>
                <button class="mini-submit" type="submit">TẠO TÀI KHOẢN NHÂN VIÊN</button>
            </form>
        </section>
        <section class="portal-panel management-panel admin-user-management" data-admin-user-management>
            <div class="panel-heading"><div><span class="portal-kicker">PHÂN QUYỀN</span><h2>Danh sách tài khoản</h2></div><span class="panel-count">@Model.AdminUsers.Count quản trị · @Model.EmployeeUsers.Count nhân viên · @Model.CustomerUsers.Count khách hàng</span></div>
            <p class="panel-help">Tài khoản được tách theo vai trò. Mỗi danh sách có ô tìm kiếm riêng; có thể đổi vai trò ở cột thao tác.</p>
            <nav class="admin-user-tabs" aria-label="Loại tài khoản">
                <button type="button" class="@(selectedUserGroup == "admin" ? "is-active" : "")" data-user-group-tab="admin" aria-pressed="@(selectedUserGroup == "admin" ? "true" : "false")">Quản trị viên (@Model.AdminUsers.Count)</button>
                <button type="button" class="@(selectedUserGroup == "employee" ? "is-active" : "")" data-user-group-tab="employee" aria-pressed="@(selectedUserGroup == "employee" ? "true" : "false")">Nhân viên (@Model.EmployeeUsers.Count)</button>
                <button type="button" class="@(selectedUserGroup == "customer" ? "is-active" : "")" data-user-group-tab="customer" aria-pressed="@(selectedUserGroup == "customer" ? "true" : "false")">Khách hàng (@Model.CustomerUsers.Count)</button>
            </nav>
            @{
                var accountGroups = new[]
                {
                    (Key: "admin", Title: "Tài khoản quản trị viên", Empty: "Chưa có tài khoản quản trị viên.", Users: Model.AdminUsers),
                    (Key: "employee", Title: "Tài khoản nhân viên", Empty: "Chưa có tài khoản nhân viên.", Users: Model.EmployeeUsers),
                    (Key: "customer", Title: "Tài khoản khách hàng", Empty: "Chưa có tài khoản khách hàng.", Users: Model.CustomerUsers)
                };
            }
            @foreach (var group in accountGroups)
            {
                <div class="admin-user-group" data-user-group-panel="@group.Key" hidden="@(group.Key != selectedUserGroup ? "hidden" : null)">
                    <div class="admin-user-group-heading"><h3>@group.Title</h3><span>@group.Users.Count tài khoản</span></div>
                    <label class="admin-user-search-label">Tìm theo tên, email@(group.Key == "customer" ? ", số điện thoại, địa chỉ hoặc giới tính" : string.Empty)
                        <input class="portal-input" type="search" data-user-search placeholder="Nhập từ khóa cần tìm..." autocomplete="off" />
                    </label>
                    @if (group.Users.Count == 0)
                    {
                        <p class="empty-orders" data-user-empty>@group.Empty</p>
                    }
                    else
                    {
                        <div class="table-scroll"><table class="management-table"><thead><tr><th>Thành viên</th><th>Email</th>@if (group.Key == "customer") { <th>Thông tin hồ sơ</th> }<th>Vai trò</th><th>Đổi vai trò</th></tr></thead><tbody>
                        @foreach (var user in group.Users)
                        {
                            <tr data-user-row data-user-search-text="@user.DisplayName @user.Email @user.PhoneNumber @user.Address @user.Gender">
                                <td>@user.DisplayName</td><td>@user.Email</td>
                                @if (group.Key == "customer")
                                {
                                    <td><details class="admin-customer-details"><summary class="text-action">Xem chi tiết</summary><div class="admin-customer-profile">
                                        @if (!string.IsNullOrWhiteSpace(user.AvatarImageId))
                                        {
                                            <img class="admin-customer-avatar" src="@AvatarStorage.GetDisplayUrl(user.AvatarImageId)" alt="Ảnh đại diện của @user.DisplayName" />
                                        }
                                        else
                                        {
                                            <span class="admin-customer-avatar admin-customer-avatar-placeholder" aria-label="Chưa có ảnh đại diện">@(string.IsNullOrWhiteSpace(user.DisplayName) ? "?" : user.DisplayName.Trim()[0].ToString().ToUpperInvariant())</span>
                                        }
                                        <dl><div><dt>Số điện thoại</dt><dd>@(string.IsNullOrWhiteSpace(user.PhoneNumber) ? "Chưa cập nhật" : user.PhoneNumber)</dd></div><div><dt>Địa chỉ</dt><dd>@(string.IsNullOrWhiteSpace(user.Address) ? "Chưa cập nhật" : user.Address)</dd></div><div><dt>Giới tính</dt><dd>@(string.IsNullOrWhiteSpace(user.Gender) ? "Chưa cập nhật" : user.Gender)</dd></div></dl>
                                    </div></details></td>
                                }
                                <td><span class="role-badge">@user.Role</span></td>
                                <td><form asp-action="SetRole" method="post" class="inline-action-form"><input type="hidden" name="userId" value="@user.Id" /><input type="hidden" name="userGroup" value="@group.Key" /><select name="role" class="portal-select" aria-label="Vai trò của @user.Email">
                                    @foreach (var role in AppRoles.All) { if (role == user.Role) { <option value="@role" selected>@role</option> } else { <option value="@role">@role</option> } }
                                </select><button class="mini-submit" type="submit">Lưu</button></form></td>
                            </tr>
                        }
                        <tr data-user-no-results hidden><td colspan="@(group.Key == "customer" ? 5 : 4)">Không tìm thấy tài khoản phù hợp.</td></tr>
                        </tbody></table></div>
                    }
                </div>
            }
        </section>
    }
    else if (tab == "orders")
    {
        <section class="portal-panel management-panel"><div class="panel-heading"><div><span class="portal-kicker">HOẠT ĐỘNG GẦN ĐÂY</span><h2>Đơn hàng</h2></div><a asp-controller="Staff" asp-action="Index" class="portal-outline-link">Mở bàn vận hành ↗</a></div>
            @if (Model.RecentOrders.Count == 0) { <p class="empty-orders">Chưa có đơn hàng.</p> }
            else { <div class="table-scroll"><table class="management-table"><thead><tr><th>Đơn</th><th>Khách hàng</th><th>Sản phẩm</th><th>Tổng</th><th>Trạng thái</th><th></th></tr></thead><tbody>
            @foreach (var order in Model.RecentOrders)
            {
                <tr><td>#@order.Id.ToString("D6")<small>@order.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></td><td>@order.CustomerName<small>@order.Phone</small><small>@order.Address</small></td><td>@foreach (var item in order.Items) { <span>@item.ProductName · @item.Size × @item.Quantity<br /></span> }</td><td>@order.Total.ToString("N0")₫@if (order.DiscountAmount > 0) { <small>Voucher @order.PromotionCode · −@order.DiscountAmount.ToString("N0")₫</small> }</td><td><span class="status-pill status-@order.Status.ToLowerInvariant()">@order.Status</span></td><td><a asp-controller="Staff" asp-action="Index" class="text-action">Xử lý</a></td></tr>
            }
            </tbody></table></div> }
        </section>
    }
    else if (tab == "videos")
    {
        <section class="portal-panel management-panel"><div class="panel-heading"><div><span class="portal-kicker">VIDEO FASHION · ĐĂNG VIDEO</span><h2>Thêm video outfit</h2></div><span class="panel-count">MP4 / WebM · tối đa 50 MB</span></div>
            <p class="panel-help">Mỗi video phải gắn với một sản phẩm đang bán. Có thể tải video trực tiếp từ máy lên và đăng ngay lên trang Video fashion.</p>
            <form asp-action="UploadFashionVideo" method="post" enctype="multipart/form-data" class="product-admin-form fashion-video-upload-form">
                <label>Sản phẩm<select name="ProductSlug" class="portal-select" required><option value="">Chọn sản phẩm</option>@foreach (var product in Model.Products.Where(product => product.IsActive)) { <option value="@product.Slug">@product.Name · @product.Price.ToString("N0")₫</option> }</select></label>
                <label class="wide-field">Chú thích video<input name="Caption" class="portal-input" maxlength="180" placeholder="Ví dụ: Outfit linen cho ngày nắng" required /></label>
                <label class="wide-field">Tệp video<input name="VideoFile" class="portal-input" type="file" accept="video/mp4,video/webm,.mp4,.webm" required /><small>MP4/WebM tối đa 50 MB. Hỗ trợ video ngang và dọc; trình phát giữ nguyên khung hình.</small></label>
                <button class="mini-submit" type="submit">ĐĂNG VIDEO</button>
            </form>
        </section>
        <section class="portal-panel management-panel"><div class="panel-heading"><div><span class="portal-kicker">VIDEO FASHION · THƯ VIỆN</span><h2>Video đã đăng</h2></div><span class="panel-count">@Model.FashionVideos.Count video</span></div>
            @if (Model.FashionVideos.Count == 0) { <p class="empty-orders">Chưa có video. Tải video đầu tiên lên để hiển thị trong trang Video fashion.</p> }
            else
            {
                <div class="fashion-video-admin-list">
                    @foreach (var video in Model.FashionVideos)
                    {
                        var productName = Model.Products.FirstOrDefault(product => product.Slug == video.ProductSlug)?.Name ?? video.ProductSlug;
                        <article class="fashion-video-admin-card"><video controls muted playsinline preload="metadata"><source src="@Url.Content($"~/videos/fashion/{video.VideoFileName}")" type="@(video.VideoFileName.EndsWith(".webm", StringComparison.OrdinalIgnoreCase) ? "video/webm" : "video/mp4")" /></video><div><strong>@productName</strong><p>@video.Caption</p><span class="status-pill">@(video.IsActive ? "Đang hiển thị" : "Đã ẩn")</span><div class="fashion-video-admin-actions"><form asp-action="SetFashionVideoVisibility" method="post"><input type="hidden" name="id" value="@video.Id" /><input type="hidden" name="isActive" value="@(!video.IsActive)" /><button class="mini-submit" type="submit">@(video.IsActive ? "ẨN VIDEO" : "HIỆN VIDEO")</button></form><form asp-action="DeleteFashionVideo" method="post" onsubmit="return confirm('Xóa video này vĩnh viễn?')"><input type="hidden" name="id" value="@video.Id" /><button class="text-action danger-action" type="submit">Xóa</button></form></div></div></article>
                    }
                </div>
            }
        </section>
    }
    else if (tab == "promotions")
    {
        <section class="portal-panel management-panel">
            <div class="panel-heading"><div><span class="portal-kicker">CAMPAIGN · CREATE</span><h2>Tạo voucher giảm giá</h2></div></div>
            <p class="panel-help">Mã được tính lại và xác nhận trên máy chủ khi khách đặt hàng. Thời hạn áp dụng theo giờ Việt Nam.</p>
            <form asp-action="CreatePromotion" method="post" class="product-admin-form promotion-admin-form">
                <label>Mã voucher<input name="Code" class="portal-input" minlength="3" maxlength="30" pattern="[A-Za-z0-9_-]+" placeholder="WELCOME10" required /><small>Chữ cái, số, dấu gạch ngang hoặc gạch dưới.</small></label>
                <label>Loại giảm<select name="Type" class="portal-select" required><option value="Percentage">Theo phần trăm</option><option value="FixedAmount">Số tiền cố định</option></select></label>
                <label>Mức giảm<input name="Value" class="portal-input" type="number" min="1" max="1000000000" step="0.01" value="10" required /><small>Phần trăm: 1–100. Số tiền: từ 1.000₫.</small></label>
                <label>Đơn tối thiểu (₫)<input name="MinimumOrderAmount" class="portal-input" type="number" min="0" step="1000" value="0" required /></label>
                <label>Giảm tối đa (₫)<input name="MaximumDiscountAmount" class="portal-input" type="number" min="1" step="1000" placeholder="Không giới hạn" /><small>Chỉ áp dụng cho voucher phần trăm.</small></label>
                <label>Số lượt dùng tối đa<input name="MaximumRedemptions" class="portal-input" type="number" min="1" max="1000000" placeholder="Không giới hạn" /></label>
                <label>Bắt đầu từ ngày<input name="StartsOn" class="portal-input" type="date" value="@DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7)).ToString("yyyy-MM-dd")" required /></label>
                <label>Kết thúc hết ngày<input name="EndsOn" class="portal-input" type="date" /></label>
                <button class="mini-submit" type="submit">TẠO VOUCHER</button>
            </form>
        </section>
        <section class="portal-panel management-panel">
            <div class="panel-heading"><div><span class="portal-kicker">CAMPAIGN · ACTIVE & HISTORY</span><h2>Danh sách voucher</h2></div><span class="panel-count">@Model.Promotions.Count mã</span></div>
            @if (Model.Promotions.Count == 0)
            {
                <p class="empty-orders">Chưa có voucher nào. Tạo mã đầu tiên để khách có thể áp dụng tại giỏ hàng.</p>
            }
            else
            {
                <div class="table-scroll"><table class="management-table"><thead><tr><th>Mã</th><th>Mức giảm</th><th>Điều kiện</th><th>Thời hạn</th><th>Lượt dùng</th><th>Trạng thái</th><th>Hành động</th></tr></thead><tbody>
                @foreach (var promotion in Model.Promotions)
                {
                    var isAvailable = promotion.IsAvailable(DateTime.UtcNow);
                    <tr><td><strong>@promotion.Code</strong></td><td>@(promotion.Type == PromotionTypes.Percentage ? $"{promotion.Value:0.##}%" : $"{promotion.Value:N0}₫")@(promotion.MaximumDiscountAmount is not null ? $" · tối đa {promotion.MaximumDiscountAmount.Value:N0}₫" : string.Empty)</td><td>Đơn từ @promotion.MinimumOrderAmount.ToString("N0")₫</td><td>@promotion.StartsAtUtc.AddHours(7).ToString("dd/MM/yyyy") – @(promotion.EndsAtUtc?.AddHours(7).AddDays(-1).ToString("dd/MM/yyyy") ?? "Không giới hạn")</td><td>@promotion.RedemptionCount / @(promotion.MaximumRedemptions?.ToString() ?? "∞")</td><td><span class="status-pill">@(isAvailable ? "Đang áp dụng" : promotion.IsActive ? "Chưa khả dụng" : "Đã tắt")</span></td><td><form asp-action="SetPromotionVisibility" method="post"><input type="hidden" name="id" value="@promotion.Id" /><input type="hidden" name="isActive" value="@(!promotion.IsActive)" /><button class="mini-submit" type="submit">@(promotion.IsActive ? "TẮT MÃ" : "BẬT MÃ")</button></form></td></tr>
                }
                </tbody></table></div>
            }
        </section>
    }
    else if (tab == "products")
    {
        <section class="portal-panel management-panel"><div class="panel-heading"><div><span class="portal-kicker">CATALOG · CREATE</span><h2>Thêm một sản phẩm</h2></div></div>
            <form asp-action="SaveProduct" method="post" enctype="multipart/form-data" class="product-admin-form">
                <label>Mã sản phẩm<input name="Slug" class="portal-input" pattern="[A-Za-z0-9-]{2,20}" maxlength="20" placeholder="FS-101" required /></label><label>Tên sản phẩm<input name="Name" class="portal-input" maxlength="120" required /></label>
                <label>Danh mục cửa hàng<select name="Category" class="portal-select"><option value="women">Đồ nữ</option><option value="men">Đồ nam</option><option value="accessories">Phụ kiện</option></select></label><label>Giá (₫)<input name="Price" class="portal-input" type="number" min="1000" step="1000" required /></label>
                <label>Ảnh sản phẩm (tối đa 150 MB)<input name="ImageFile" class="portal-input product-image-upload" type="file" required /><small>Tên tệp tùy ý. Hỗ trợ JPEG, PNG, WebP, GIF, BMP, TIFF, AVIF và HEIF.</small></label><label>Màu sắc<input name="Color" class="portal-input" maxlength="50" /></label><label>Kích cỡ, cách nhau bằng dấu phẩy<input name="SizesCsv" class="portal-input" value="S,M,L" required /></label><label>Tồn kho<input name="Stock" class="portal-input" type="number" min="0" value="10" required /></label><label class="wide-field">Mô tả<textarea name="Description" class="portal-input" maxlength="500" rows="2"></textarea></label><label class="portal-check"><input name="IsActive" type="checkbox" value="true" checked /> Đang bán</label><button class="mini-submit" type="submit">THÊM SẢN PHẨM</button>
            </form>
        </section>
        <section class="portal-panel management-panel" data-product-search-panel><div class="panel-heading"><div><span class="portal-kicker">CATALOG · INVENTORY</span><h2>Danh mục sản phẩm</h2></div><span class="panel-count">@Model.Products.Count mặt hàng</span></div>
            <form class="product-search" role="search" data-product-search-form><label for="admin-product-search">Tìm theo tên hoặc mã sản phẩm</label><input id="admin-product-search" class="portal-input" type="search" data-product-search placeholder="Nhập tên hoặc mã sản phẩm..." autocomplete="off" /><button class="mini-submit" type="submit">TÌM</button><span data-product-search-count aria-live="polite"></span></form>
            <div class="table-scroll"><table class="management-table"><thead><tr><th>Sản phẩm</th><th>Danh mục</th><th>Giá</th><th>Tồn kho</th><th>Trạng thái</th><th>Hành động</th></tr></thead><tbody>
            @foreach (var product in Model.Products)
            {
                <tr data-product-search-row data-search="@product.Name @product.Slug @product.Category"><td>@product.Name<small>@product.Slug</small></td><td>@(product.Category switch { "women" => "Đồ nữ", "men" => "Đồ nam", _ => "Phụ kiện" })</td><td>@product.Price.ToString("N0")₫</td><td>@product.Stock</td><td>@(product.IsActive ? "Đang bán" : "Đã ẩn")</td><td class="table-actions"><details><summary class="text-action">Chỉnh sửa</summary><form asp-action="SaveProduct" method="post" enctype="multipart/form-data" class="product-edit-form"><input type="hidden" name="Slug" value="@product.Slug" /><label>Tên<input name="Name" class="portal-input" value="@product.Name" maxlength="120" required /></label>
                    <label>Danh mục cửa hàng<select name="Category" class="portal-select"><option value="women" selected="@(product.Category == "women")">Đồ nữ</option><option value="men" selected="@(product.Category == "men")">Đồ nam</option><option value="accessories" selected="@(product.Category == "accessories")">Phụ kiện</option></select></label><label>Giá<input name="Price" class="portal-input" type="number" value="@product.Price" min="1000" step="1000" required /></label><label>Ảnh mới (tối đa 150 MB, tùy chọn)<input name="ImageFile" class="portal-input product-image-upload" type="file" /><small>Tên tệp tùy ý; bỏ trống để giữ ảnh hiện tại.</small></label><label>Màu<input name="Color" class="portal-input" value="@product.Color" maxlength="50" /></label><label>Kích cỡ<input name="SizesCsv" class="portal-input" value="@product.SizesCsv" required /></label><label>Tồn kho<input name="Stock" class="portal-input" type="number" value="@product.Stock" min="0" required /></label><label>Mô tả<textarea name="Description" class="portal-input" rows="2">@product.Description</textarea></label><label class="portal-check"><input name="IsActive" type="checkbox" value="true" checked="@(product.IsActive)" /> Đang bán</label><button class="mini-submit" type="submit">Lưu</button></form></details>
                    @if (product.IsActive) { <form asp-action="DeleteProduct" method="post" class="inline-delete-form"><input type="hidden" name="slug" value="@product.Slug" /><button class="text-action danger-action" type="submit">Ẩn</button></form> }
                </td></tr>
            }
            <tr data-product-search-empty hidden><td colspan="6">Không tìm thấy sản phẩm phù hợp.</td></tr>
            </tbody></table></div>
        </section>
    }
</section>
@section Scripts {
    <script src="~/js/admin-stock-receipts.js" asp-append-version="true"></script>
    <script src="~/js/admin-users.js" asp-append-version="true"></script>
}
