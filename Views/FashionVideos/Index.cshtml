@model IReadOnlyList<StorefrontFashionVideo>
@{
    Layout = null;
    ViewData["Title"] = "W-video";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#211b19" />
    <meta name="description" content="Lướt video outfit W Studio và mua ngay sản phẩm bạn yêu thích." />
    <title>@ViewData["Title"] — W Studio</title>
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/editorial.css" asp-append-version="true" />
</head>
<body class="fashion-video-page">
    <header class="fashion-video-header">
        <a class="fashion-video-back" asp-controller="Home" asp-action="Index" aria-label="Quay lại cửa hàng">← <span>Cửa hàng</span></a>
        <a class="fashion-video-brand" asp-controller="Home" asp-action="Index">W <span>STUDIO</span></a>
        <span class="fashion-video-header-label">W-VIDEO</span>
    </header>
    <main class="fashion-video-main">
        @if (Model.Count == 0)
        {
            <section class="fashion-video-empty"><span>W STUDIO · W-VIDEO</span><h1>Video mới sắp lên sóng.</h1><p>Hiện chưa có video sản phẩm nào được đăng.</p><a asp-controller="Home" asp-action="Index">Khám phá cửa hàng ↗</a></section>
        }
        else
        {
            <form class="fashion-video-search" role="search" data-fashion-video-search-form>
                <label for="fashion-video-search-input">Tìm video theo sản phẩm hoặc từ khóa</label>
                <div class="fashion-video-search-control"><span aria-hidden="true">⌕</span><input id="fashion-video-search-input" type="search" data-fashion-video-search-input placeholder="Nhập tên sản phẩm hoặc chú thích..." autocomplete="off" /><button type="button" data-fashion-video-search-clear aria-label="Xóa nội dung tìm kiếm" hidden>×</button></div>
                <p data-fashion-video-search-count aria-live="polite">@Model.Count video</p>
            </form>
            <p class="fashion-video-search-empty" data-fashion-video-search-empty role="status" hidden>Không tìm thấy video phù hợp. Hãy thử từ khóa hoặc tên sản phẩm khác.</p>
            <div class="fashion-video-feed" aria-label="Video thời trang">
                @for (var index = 0; index < Model.Count; index++)
                {
                    var video = Model[index];
                    <article class="fashion-video-card" data-fashion-video-card data-search="@($"{video.ProductName} {video.Caption}")">
                        <div class="fashion-video-stage">
                            <video class="fashion-video-player" controls loop playsinline preload="metadata" aria-label="Video @video.Caption">
                                <source src="@Url.Content($"~/videos/fashion/{video.VideoFileName}")" type="@(video.VideoFileName.EndsWith(".webm", StringComparison.OrdinalIgnoreCase) ? "video/webm" : "video/mp4")" />
                                Trình duyệt của bạn không hỗ trợ phát video.
                            </video>
                            <div class="fashion-video-stage-top"><span>W STUDIO <i>·</i> LOOKBOOK</span><span>@((index + 1).ToString("D2")) / @Model.Count.ToString("D2")</span></div>
                            <button class="fashion-video-sound" type="button" data-video-sound aria-label="Tắt tiếng video" aria-pressed="true">TẮT TIẾNG</button>
                        </div>
                        <aside class="fashion-video-info">
                            <span class="fashion-video-eyebrow">OUTFIT ĐANG ĐƯỢC YÊU THÍCH</span>
                            <span class="fashion-video-index">LOOK @((index + 1).ToString("D2")) <i>—</i> W STUDIO</span>
                            <h2>@video.ProductName</h2>
                            <p>@video.Caption</p>
                            <div class="fashion-video-price">@video.ProductPrice.ToString("N0")<span>₫</span></div>
                            <a class="fashion-video-product" href="@Url.Action("Index", "Home", new { product = video.ProductSlug, fromFashionVideo = "1" })">
                                <span>Xem sản phẩm</span><strong>KHÁM PHÁ LOOK <b aria-hidden="true">↗</b></strong>
                            </a>
                            <span class="fashion-video-scroll-hint"><i></i> CUỘN ĐỂ KHÁM PHÁ THÊM</span>
                        </aside>
                    </article>
                }
            </div>
        }
    </main>
    <script src="~/js/fashion-videos.js" asp-append-version="true"></script>
</body>
</html>
