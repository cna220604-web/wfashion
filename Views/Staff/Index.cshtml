@model StaffDashboardViewModel
@{
    ViewData["Title"] = "Bàn làm việc nhân viên";
    var requestedTab = Context.Request.Query["tab"].ToString();
    var tab = requestedTab is "support" or "orders" or "stock" or "feedback" ? requestedTab : "overview";
}
<section class="dashboard-page staff-dashboard">
    <div class="dashboard-heading"><div><span class="portal-kicker">WORKSPACE · NHÂN VIÊN</span><h1>Bàn làm việc</h1><p>Chọn riêng hộp thư, đơn hàng, tồn kho hoặc phản hồi khách hàng.</p></div><span class="role-badge">NHÂN VIÊN</span></div>
    @if (TempData["Notice"] is string notice) { <div class="portal-alert success">@notice</div> }
    @if (TempData["Error"] is string error) { <div class="portal-alert danger">@error</div> }
    <nav class="dashboard-tabs staff-dashboard-tabs" aria-label="Khu vực nhân viên"><a class="@(tab == "overview" ? "is-active" : "")" asp-action="Index" asp-route-tab="overview">Tổng quan</a><a class="@(tab == "support" ? "is-active" : "")" asp-action="Index" asp-route-tab="support">Hộp thư khách hàng</a><a class="@(tab == "orders" ? "is-active" : "")" asp-action="Index" asp-route-tab="orders">Đơn hàng</a><a class="@(tab == "stock" ? "is-active" : "")" asp-action="Index" asp-route-tab="stock">Tồn kho</a><a class="@(tab == "feedback" ? "is-active" : "")" asp-action="Index" asp-route-tab="feedback">Đánh giá</a></nav>
    @if (tab == "support")
    {
    <section class="portal-panel support-inbox" data-support-staff>
        <div class="panel-heading"><div><span class="portal-kicker">TƯ VẤN TRỰC TUYẾN</span><h2>Hộp thư khách hàng</h2></div><div class="support-presence"><span id="staff-presence-state">Đang ngoại tuyến</span><button id="staff-presence-toggle" class="mini-submit" type="button" aria-pressed="false">Bật trực tuyến</button></div></div>
        <div class="support-workspace">
            <div id="support-conversation-list" class="support-conversation-list" aria-label="Danh sách hội thoại"><p class="support-empty">Đang tải hội thoại…</p></div>
            <div class="support-thread">
                <div class="support-thread-heading"><strong id="support-thread-title">Chọn một hội thoại</strong><span id="support-thread-state"></span><button id="support-claim" class="mini-submit" type="button" hidden>Nhận tư vấn</button><button id="support-close" class="mini-submit support-close" type="button" hidden>Kết thúc</button></div>
                <div id="support-thread-messages" class="support-thread-messages" aria-live="polite"><p class="support-empty">Bật trạng thái trực tuyến để nhận khách hoặc chọn hội thoại đang chờ.</p></div>
                <form id="support-reply-form" class="support-reply-form" hidden><label class="visually-hidden" for="support-reply-input">Tin nhắn trả lời</label><input id="support-reply-input" maxlength="1200" placeholder="Trả lời khách hàng..." required /><button class="mini-submit" type="submit">Gửi</button></form>
                <p id="support-error" class="support-error" role="alert" hidden></p>
            </div>
        </div>
        <form id="support-antiforgery" hidden>@Html.AntiForgeryToken()</form>
    </section>
    }
    @if (tab == "overview")
    {
    <div class="metric-grid">
        <article class="metric-card"><span>CHỜ XÁC NHẬN</span><strong>@Model.PendingOrderCount</strong></article>
        <article class="metric-card"><span>ĐANG XỬ LÝ</span><strong>@Model.ProcessingOrderCount</strong></article>
        <article class="metric-card"><span>ĐANG GIAO</span><strong>@Model.ShippedOrderCount</strong></article>
        <article class="metric-card"><span>SẮP HẾT HÀNG · TỒN ≤ 5</span><strong>@Model.LowStockCount</strong></article>
        <article class="metric-card"><span>ĐÁNH GIÁ TỪ KHÁCH HÀNG</span><strong>@Model.ProductReviewCount</strong></article>
    </div>
    }
    @if (tab == "feedback")
    {
    <section class="portal-panel management-panel staff-feedback-panel">
        <div class="panel-heading"><div><span class="portal-kicker">TIẾNG NÓI KHÁCH HÀNG</span><h2>Đánh giá và phản hồi</h2><p>Xem đánh giá sản phẩm từ khách đã nhận hàng.</p></div><span class="panel-count">@Model.RecentProductReviews.Count mới nhất</span></div>
        @if (Model.RecentProductReviews.Count == 0)
        {
            <p class="empty-orders">Chưa có đánh giá hoặc phản hồi từ khách hàng.</p>
        }
        else
        {
            <div class="staff-feedback-list">
                @foreach (var review in Model.RecentProductReviews)
                {
                    <article class="staff-feedback-card">
                        <div class="staff-feedback-head">
                            <div><strong>@review.CustomerName</strong><span>@review.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></div>
                            <span class="staff-feedback-stars" aria-label="@review.Rating trên 5 sao">@string.Concat(Enumerable.Repeat("★", review.Rating))@string.Concat(Enumerable.Repeat("☆", 5 - review.Rating))</span>
                        </div>
                        <p class="staff-feedback-product">@review.ProductName <span>· Đơn #@review.OrderId.ToString("D6")</span></p>
                        <p class="staff-feedback-comment">@(string.IsNullOrWhiteSpace(review.Comment) ? "Khách hàng đã đánh giá sản phẩm mà không để lại nhận xét." : review.Comment)</p>
                        @if (!string.IsNullOrWhiteSpace(review.StaffReply))
                        {
                            <div class="staff-feedback-sent-reply"><strong>Đã trả lời · @review.StaffReplyBy</strong><span>@review.StaffRepliedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span><p>@review.StaffReply</p></div>
                        }
                        <form asp-action="ReplyToProductReview" method="post" class="staff-feedback-reply-form">
                            <input type="hidden" name="ReviewId" value="@review.ReviewId" />
                            <input type="hidden" name="tab" value="feedback" />
                            <label for="reply-@review.ReviewId">@(string.IsNullOrWhiteSpace(review.StaffReply) ? "Trả lời khách hàng" : "Cập nhật phản hồi")</label>
                            <textarea id="reply-@review.ReviewId" name="Reply" maxlength="1000" rows="3" required placeholder="Viết phản hồi lịch sự, hữu ích...">@review.StaffReply</textarea>
                            <button type="submit" class="mini-submit">@(string.IsNullOrWhiteSpace(review.StaffReply) ? "GỬI TRẢ LỜI" : "LƯU PHẢN HỒI")</button>
                        </form>
                    </article>
                }
            </div>
        }
    </section>
    }
    @if (tab == "orders")
    {
    <section class="portal-panel management-panel"><div class="panel-heading"><div><span class="portal-kicker">ĐƠN HÀNG GẦN ĐÂY</span><h2>Quản lý đơn hàng</h2></div><span class="panel-count">@Model.Orders.Count đơn</span></div>
        <form asp-action="Index" method="get" class="product-search staff-order-search" role="search">
            <label for="staff-order-search">Tìm theo mã đơn, tên hoặc số điện thoại</label>
            <input id="staff-order-search" class="portal-input" type="search" name="search" value="@Model.OrderSearch" maxlength="100" placeholder="Ví dụ: 000123, Nguyễn An, 09..." autocomplete="off" />
            <input type="hidden" name="tab" value="orders" />
            @if (!string.IsNullOrWhiteSpace(Model.StatusFilter)) { <input type="hidden" name="status" value="@Model.StatusFilter" /> }
            <button class="mini-submit" type="submit">TÌM ĐƠN</button>
            @if (!string.IsNullOrWhiteSpace(Model.OrderSearch)) { <a class="text-action" asp-action="Index" asp-route-tab="orders" asp-route-status="@Model.StatusFilter">Xóa tìm kiếm</a> }
        </form>
        <nav class="dashboard-tabs staff-order-filters" aria-label="Lọc trạng thái đơn hàng">
            <a class="@(Model.StatusFilter == null ? "is-active" : "")" asp-action="Index" asp-route-tab="orders" asp-route-search="@Model.OrderSearch">Tất cả</a>
            <a class="@(Model.StatusFilter == OrderStatuses.Pending ? "is-active" : "")" asp-action="Index" asp-route-tab="orders" asp-route-status="@OrderStatuses.Pending" asp-route-search="@Model.OrderSearch">Chờ xác nhận</a>
            <a class="@(Model.StatusFilter == OrderStatuses.Processing ? "is-active" : "")" asp-action="Index" asp-route-tab="orders" asp-route-status="@OrderStatuses.Processing" asp-route-search="@Model.OrderSearch">Đang xử lý</a>
            <a class="@(Model.StatusFilter == OrderStatuses.Shipped ? "is-active" : "")" asp-action="Index" asp-route-tab="orders" asp-route-status="@OrderStatuses.Shipped" asp-route-search="@Model.OrderSearch">Đang giao</a>
            <a class="@(Model.StatusFilter == OrderStatuses.Delivered ? "is-active" : "")" asp-action="Index" asp-route-tab="orders" asp-route-status="@OrderStatuses.Delivered" asp-route-search="@Model.OrderSearch">Đã giao</a>
            <a class="@(Model.StatusFilter == OrderStatuses.Cancelled ? "is-active" : "")" asp-action="Index" asp-route-tab="orders" asp-route-status="@OrderStatuses.Cancelled" asp-route-search="@Model.OrderSearch">Đã hủy</a>
            <a class="@(Model.StatusFilter == "ReturnRequested" ? "is-active" : "")" asp-action="Index" asp-route-tab="orders" asp-route-status="ReturnRequested" asp-route-search="@Model.OrderSearch">Yêu cầu hoàn trả</a>
        </nav>
        @if (Model.Orders.Count == 0) { <p class="empty-orders">Không có đơn hàng phù hợp.</p> }
        else
        {
            <div class="table-scroll"><table class="management-table"><thead><tr><th>Đơn hàng</th><th>Khách hàng</th><th>Sản phẩm</th><th>Tổng tiền</th><th>Trạng thái</th><th>Cập nhật</th></tr></thead><tbody>
            @foreach (var order in Model.Orders)
            {
                <tr><td>#@order.Id.ToString("D6")<small>@order.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>@if (order.ReturnRequestedAtUtc is not null) { <small class="return-request-badge">Có yêu cầu hoàn trả</small> }<a asp-action="OrderDetails" asp-route-id="@order.Id" class="text-action">Xem chi tiết</a></td><td>@order.CustomerName<small>@order.Phone</small><small>@order.Address</small>@if (!string.IsNullOrWhiteSpace(order.Note)) { <small>Ghi chú: @order.Note</small> }</td><td>@foreach (var item in order.Items) { <span>@item.ProductName · @item.Size × @item.Quantity<br /></span> }</td><td>@order.Total.ToString("N0")₫<small>COD</small></td><td><span class="status-pill status-@order.Status.ToLowerInvariant()">@order.Status</span></td><td>
                    @if (order.Status == OrderStatuses.Pending || order.Status == OrderStatuses.Processing || order.Status == OrderStatuses.Shipped)
                    {
                        <form asp-action="UpdateOrderStatus" method="post" class="inline-action-form"><input type="hidden" name="tab" value="orders" /><input type="hidden" name="id" value="@order.Id" /><select name="status" class="portal-select" aria-label="Trạng thái đơn #@order.Id">
                            @if (order.Status == OrderStatuses.Pending) { <option value="Processing">Xác nhận</option><option value="Cancelled">Hủy đơn</option> }
                            @if (order.Status == OrderStatuses.Processing) { <option value="Shipped">Đã gửi hàng</option><option value="Cancelled">Hủy đơn</option> }
                            @if (order.Status == OrderStatuses.Shipped) { <option value="Delivered">Đã giao</option> }
                        </select><button class="mini-submit" type="submit">Lưu</button></form>
                    }
                </td></tr>
            }
            </tbody></table></div>
        }
    </section>
    }
    @if (tab == "stock")
    {
    <section class="portal-panel management-panel" data-product-search-panel><div class="panel-heading"><div><span class="portal-kicker">SẢN PHẨM</span><h2>Kiểm kê tồn kho</h2></div><span class="panel-count">@Model.Products.Count mặt hàng</span></div>
        <form class="product-search" role="search" data-product-search-form><label for="staff-product-search">Tìm theo tên hoặc mã sản phẩm</label><input id="staff-product-search" class="portal-input" type="search" data-product-search placeholder="Nhập tên hoặc mã sản phẩm..." autocomplete="off" /><button class="mini-submit" type="submit">TÌM</button><span data-product-search-count aria-live="polite"></span></form>
        <div class="table-scroll"><table class="management-table"><thead><tr><th>Sản phẩm</th><th>Danh mục</th><th>Giá</th><th>Tồn kho</th><th>Cập nhật</th></tr></thead><tbody>
        @foreach (var product in Model.Products)
        {
            <tr data-product-search-row data-search="@product.Name @product.Slug @product.Category"><td>@product.Name<small>@product.Slug</small></td><td>@(product.Category switch { "women" => "Đồ nữ", "men" => "Đồ nam", _ => "Phụ kiện" })</td><td>@product.Price.ToString("N0")₫</td><td>@product.Stock</td><td><form asp-action="UpdateStock" method="post" class="inline-action-form"><input type="hidden" name="tab" value="stock" /><input type="hidden" name="slug" value="@product.Slug" /><input class="stock-input" type="number" name="stock" value="@product.Stock" min="0" max="100000" aria-label="Số lượng @product.Name" required /><button class="mini-submit" type="submit">Cập nhật</button></form></td></tr>
        }
        <tr data-product-search-empty hidden><td colspan="5">Không tìm thấy sản phẩm phù hợp.</td></tr>
        </tbody></table></div>
    </section>
    }
</section>
@section Scripts {
    <script src="~/js/staff-chat.js" asp-append-version="true"></script>
    <script>
        (() => {
            const key = 'wstudio.staff.scrollY';
            const savedPosition = sessionStorage.getItem(key);
            if (savedPosition !== null) {
                sessionStorage.removeItem(key);
                requestAnimationFrame(() => window.scrollTo(0, Number(savedPosition)));
            }

            const savePosition = () => sessionStorage.setItem(key, String(window.scrollY));
            document.querySelectorAll('.staff-order-search, .inline-action-form, .staff-feedback-reply-form').forEach(form => {
                form.addEventListener('submit', savePosition);
            });
            document.querySelectorAll('.staff-order-filters a, .staff-order-search a').forEach(link => {
                link.addEventListener('click', savePosition);
            });
        })();
    </script>
}
